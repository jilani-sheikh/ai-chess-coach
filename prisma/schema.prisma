datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  games         Game[]
}

model Game {
  id         String    @id @default(cuid())
  userId     String
  pgn        String    @db.Text
  white      String
  black      String
  result     String
  event      String?
  site       String?
  round      String?
  playedAt   DateTime?
  totalMoves Int
  userColor  String?   // "WHITE" | "BLACK" (or "w" | "b")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis GameAnalysis?

  @@index([userId])
  @@index([playedAt])
  @@index([createdAt])
}

model GameAnalysis {
  id                String         @id @default(cuid())
  gameId            String         @unique
  status            String         // "PENDING" | "ANALYZING" | "COMPLETED" | "FAILED"
  engine            String         @default("Stockfish 18")
  depth             Int            @default(10)
  accuracy          Float?
  whiteAccuracy     Float?
  blackAccuracy     Float?
  acpl              Float?
  whiteAcpl         Float?
  blackAcpl         Float?
  inaccuracies      Int            @default(0)
  mistakes          Int            @default(0)
  blunders          Int            @default(0)
  whiteInaccuracies Int            @default(0)
  whiteMistakes     Int            @default(0)
  whiteBlunders     Int            @default(0)
  blackInaccuracies Int            @default(0)
  blackMistakes     Int            @default(0)
  blackBlunders     Int            @default(0)
  errorMessage      String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  game              Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  moves             MoveAnalysis[]

  @@index([status])
  @@index([createdAt])
}

model MoveAnalysis {
  id            String       @id @default(cuid())
  analysisId    String
  moveIndex     Int
  moveNumber    Int
  color         String       // "w" | "b"
  san           String
  fen           String       @db.Text
  score         Float        // In pawns / centipawns normalized to White's perspective (+ = White advantage, - = Black advantage)
  mate          Int?         // Mate in N (+ = White mates, - = Black mates)
  evalType      String       // "cp" | "mate"
  bestMove      String       // Engine best move in UCI format (e.g. "e2e4")
  bestMoveSan   String?      // Engine best move in SAN format (e.g. "e4")
  playedMove    String       // Played move in SAN format
  centipawnLoss Int          @default(0) // Non-negative loss from moving player's perspective
  classification String      // "best" | "good" | "inaccuracy" | "mistake" | "blunder"
  accuracy      Float        // 0 to 100 move accuracy metric

  analysis      GameAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([analysisId, moveIndex])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
